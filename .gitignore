# ==============================================================================
# .gitignore — Proyecto Tesis Edificio 18P (BIM ISO 19650 & Ingeniería Civil)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Entornos Virtuales
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 2. Node.js & npm (Pipeline de Tesis Word/JS)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ------------------------------------------------------------------------------
# 3. Autodesk Revit & Navisworks (Archivos temporales y de respaldo)
# ------------------------------------------------------------------------------
# Backups automáticos de Revit (*.0001.rvt, *.0002.rfa)
*.[0-9][0-9][0-9][0-9].rvt
*.[0-9][0-9][0-9][0-9].rfa
*.slog
*.log
*.journal
*.bak
*.nwc

# ------------------------------------------------------------------------------
# 4. LaTeX & MiKTeX (Archivos temporales de compilación)
# ------------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.lof
*.lot

# ------------------------------------------------------------------------------
# 5. Sistema Operativo & IDEs
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDEs & Editores
.idea/
.vscode/
*.swp
*.swo

# ------------------------------------------------------------------------------
# 6. Gemini / Antigravity Agent Internal Scratch Files
# ------------------------------------------------------------------------------
.gemini/
.agents/
scratch/
